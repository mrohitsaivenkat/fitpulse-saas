# FitPulse SaaS - Environment Configuration Template
# Safe placeholder values only - DO NOT commit real secrets

# Flask Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=fitpulse-dev-secret-key-change-in-production

# Database Configuration (Phase 2A)
# Local Development (SQLite):
